{
  "name": "Webhook to Slack #alert",
  "nodes": [
    {
      "id": "n1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "slack-alert-0001",
      "parameters": {
        "httpMethod": "POST",
        "path": "slack-alert",
        "responseMode": "onReceived"
      }
    },
    {
      "id": "n2",
      "name": "Create #alert Channel",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [240, 0],
      "onError": "continueRegularOutput",
      "notes": "채널이 이미 있으면(name_taken) 오류를 무시하고 계속 진행",
      "parameters": {
        "authentication": "accessToken",
        "resource": "channel",
        "operation": "create",
        "channelId": "alert",
        "name": "alert",
        "channelVisibility": "public"
      }
    },
    {
      "id": "n3",
      "name": "Send JSON to Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [480, 0],
      "parameters": {
        "authentication": "accessToken",
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "mode": "name", "value": "alert" },
        "messageType": "text",
        "text": "=🚨 Webhook 알림\n```{{ JSON.stringify($('Webhook').item.json.body, null, 2) }}```",
        "otherOptions": {}
      }
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Create #alert Channel", "type": "main", "index": 0 }]] },
    "Create #alert Channel": { "main": [[{ "node": "Send JSON to Slack", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
